# ── Placeta Joven · API ──────────────────────────────────────────────
# Copia este archivo a .env en Vercel y rellena los valores.
# Nunca subas secretos a git.

SITE_URL=https://joven.laplaceta.org

# Pasarela PlacetaID (plid26)
PLACETAID_BASE_URL=https://id.laplaceta.org

# Supabase (persistencia de suscripciones)
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # service_role (recomendado; omite RLS)
SUPABASE_ANON_KEY=                 # alternativo si usas políticas RLS
PLACETA_JOVEN_TABLE=placeta_joven  # nombre de la tabla (crear con sql/placeta_joven.sql)
PLACETA_JOVEN_RECOMPENSAS_TABLE=placeta_joven_recompensas  # catálogo de recompensas

