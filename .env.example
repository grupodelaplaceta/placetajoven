# ── Placeta Joven · API ──────────────────────────────────────────────
# Copia este archivo a .env en Vercel y rellena los valores.
# Nunca subas secretos a git.

SITE_URL=https://joven.laplaceta.org

# Pasarela PlacetaID (plid26)
PLACETAID_BASE_URL=https://id.laplaceta.org

# Integracion con Banco de La Placeta. La API debe validar X-API-Key y devolver
# una URL de firma de PlacetaID para la solicitud de Cuenta Joven.
PLACETA_BANCO_API_URL=
PLACETA_BANCO_API_KEY=

# Catálogo externo de caminos de PlacetaEDU (GET {URL}/pathways).
# Si no se configura, se usa el catálogo mínimo local de referencia.
PLACETAEDU_API_URL=

# API interna de la Junta para resolver expedientes de beca.
JUNTA_API_KEY=

# Valoración socioeconómica de becas en RSP.
RSP_API_URL=
RSP_API_KEY=

# Supabase (persistencia de suscripciones)
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # service_role (recomendado; omite RLS)
SUPABASE_ANON_KEY=                 # alternativo si usas políticas RLS
PLACETA_JOVEN_TABLE=placeta_joven  # nombre de la tabla (crear con sql/placeta_joven.sql)
PLACETA_JOVEN_RECOMPENSAS_TABLE=placeta_joven_recompensas  # catálogo de recompensas
PLACETA_JOVEN_KEYPOOL_TABLE=placeta_joven_keypool  # pool de keys por recompensa (códigos, solo servidor)
PLACETA_JOVEN_KEYPOOL_STOCK_VIEW=placeta_joven_keypool_stock  # vista de stock por recompensa
PLACETA_JOVEN_OPINIONES_TABLE=placeta_joven_opiniones  # opiniones públicas, sin identidad expuesta
PLACETAJOVEN_LIMITE_MENSUAL_PZ=400  # límite para recompensas del motor de actividades
PLACETAJOVEN_ADMIN_DIPS=  # lista separada por comas; no guardar identidades en el repositorio
PLACETAJOVEN_STUDIOS_JSON={}  # mapa JSON DIP -> studioId, solo en variables privadas del servidor

# El canje está bloqueado en servidor hasta integrar un cargo confirmado a Cuenta Joven.

# Lemon Squeezy
LS_API_KEY=
LS_STORE_ID=468068                       # id de la tienda
LS_WEBHOOK_SECRET=
# Variantes (id de variante) de cada plan. Obtenerlas con:
#   curl "https://api.lemonsqueezy.com/v1/variants?filter[product_id]=1342686" \
#        -H "Authorization: Bearer $LS_API_KEY" -H "Accept: application/vnd.api+json"
LS_VARIANT_MENSUAL=2097531                # variante del plan mensual (producto 1342686 · 1,95 €)
LS_VARIANT_ANUAL=2098068                  # variante del plan anual (producto 1343043 · 10 €)

# CORS extra si hiciera falta
ALLOW_ORIGIN=https://joven.laplaceta.org

# Acceso interior de pruebas. Solo activar en local o Preview de Vercel.
# Nunca activar con VERCEL_ENV=production.
PLACETAJOVEN_TEST_MODE=0
PLACETAJOVEN_TEST_KEY=cambia-esta-clave-en-local
PLACETAJOVEN_TEST_DIP=TEST-PLACETA-JOVEN
PLACETAJOVEN_TEST_EDAD=25
PLACETAJOVEN_TEST_PANEL=admin  # admin o studio, solo si TEST_MODE está habilitado fuera de producción
