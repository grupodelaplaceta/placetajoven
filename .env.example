# ── Placeta Joven · API ──────────────────────────────────────────────
# Copia este archivo a .env y rellena los valores en producción (Vercel).
# Nunca subas secretos a git.

SITE_URL=https://joven.laplaceta.org

# Pasarela PlacetaID (plid26)
PLACETAID_BASE_URL=https://id.laplaceta.org

# Lemon Squeezy
LS_API_KEY=                  # API key (https://app.lemonsqueezy.com/settings/api)
LS_STORE_ID=                 # id de la tienda
LS_WEBHOOK_SECRET=           # secreto del webhook de Lemon Squeezy
# Variantes (id de variante) de cada plan. Obtenerlas con:
#   curl "https://api.lemonsqueezy.com/v1/variants?filter[product_id]=1342686" -H "Authorization: Bearer $LS_API_KEY" -H "Accept: application/vnd.api+json"
LS_VARIANT_MENSUAL=          # variante del plan mensual (producto 1342686 · 1,95 €)
LS_VARIANT_ANUAL=            # variante del plan anual / Drop Joven '26 (producto 1343043 · 10 €)

# Persistencia (opcional). Sin MONGODB_URI la API usa memoria (no persistente).
MONGODB_URI=
MONGODB_DB=laplaceta

# CORS extra si hiciera falta
ALLOW_ORIGIN=https://joven.laplaceta.org
