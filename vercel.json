{
  "version": 2,
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/status", "dest": "/api/status.js" },
    { "src": "/api/planes", "dest": "/api/planes.js" },
    { "src": "/api/test-login", "dest": "/api/test-login.js" },
    { "src": "/api/alta", "dest": "/api/alta.js" },
    { "src": "/api/renovar", "dest": "/api/renovar.js" },
    { "src": "/api/cancelar", "dest": "/api/cancelar.js" },
    { "src": "/api/verificar", "dest": "/api/verificar.js" },
    { "src": "/api/recompensas", "dest": "/api/recompensas.js" },
    { "src": "/api/keys", "dest": "/api/keys.js" },
    { "src": "/api/caminos", "dest": "/api/caminos.js" },
    { "src": "/api/cuenta-joven", "dest": "/api/cuenta-joven.js" },
    { "src": "/api/protecciones", "dest": "/api/protecciones.js" },
    { "src": "/api/becas", "dest": "/api/becas.js" },
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/entrar", "dest": "/public/espacio/inicio.html" },
    { "src": "/mi", "dest": "/public/mi.html" },
    { "src": "/espacio/(.*)", "dest": "/public/espacio/$1" },
    { "src": "/terminos", "dest": "/public/terminos.html" },
    { "src": "/privacidad", "dest": "/public/privacidad.html" },
    { "src": "/auth/(.*)", "dest": "/public/auth/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
